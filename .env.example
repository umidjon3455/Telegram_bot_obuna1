BOT_TOKEN=replace-with-your-bot-token
ADMIN_IDS=123456789
REQUIRED_CHANNELS=@channel_one,@channel_two,@channel_three

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/telegram_db
REDIS_URL=redis://localhost:6379/0

USE_WEBHOOK=false
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
HOST=0.0.0.0
PORT=8080

SPAM_RATE_LIMIT=5
SPAM_RATE_WINDOW=10
REFERRAL_BONUS=1
BROADCAST_DELAY=0.05
